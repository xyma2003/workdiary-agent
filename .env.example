# Select exactly one provider: siliconflow, openai, openai-compatible, anthropic
LLM_PROVIDER=siliconflow
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Work-day boundary used when collecting Git commits.
WORKDIARY_TIMEZONE=Asia/Shanghai

# ─── SiliconFlow ───────────────────────────────────────────────────────────
SILICONFLOW_API_KEY=sk-...
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-32B

# ─── Official OpenAI ───────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Other OpenAI-compatible provider ──────────────────────────────────────
# LLM_PROVIDER=openai-compatible
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://provider.example.com/v1
# OPENAI_MODEL=provider-model-name

# ─── Anthropic ─────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Corporate Anthropic proxy alternative:
# ANTHROPIC_BASE_URL=https://your-proxy-base-url
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_CUSTOM_HEADERS=X-Custom-Header: value
